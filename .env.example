# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=24h
DATABASE_PATH=./server/data/student_success.db
CORS_ORIGIN=http://localhost:5173

# Public URL used inside activation emails (must be reachable by invited users)
# Production example: https://success.youruniversity.edu
APP_BASE_URL=http://localhost:5173
INVITE_EXPIRY_HOURS=72
PASSWORD_RESET_EXPIRY_MINUTES=30

# SMTP — required for user invitations (credentials stay on the server only)
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it into SMTP_PASS.
EMAIL_FROM=PrognosEd <your-smtp-user@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-16-char-app-password
# Optional nodemailer shortcut: gmail
# SMTP_SERVICE=gmail

# Email existence checks before invite: smtp confirms the mailbox; mx only checks the domain
EMAIL_VERIFY_MODE=smtp
EMAIL_VERIFY_STRICT=true
EMAIL_VERIFY_TIMEOUT_MS=8000

# Frontend (Vite)
VITE_API_URL=/api

# Python ML FastAPI services (see ml/README.md)
ML_ACADEMIC_API_URL=http://localhost:8000
ML_DROPOUT_API_URL=http://localhost:8001
ML_RECOMMENDER_API_URL=http://localhost:8002
ML_ANALYTICS_API_URL=http://localhost:8003
ML_FETCH_TIMEOUT_MS=8000
ML_CORS_ORIGINS=http://localhost:5173,http://localhost:3001
